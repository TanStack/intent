{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts",
        "evals/intent-discovery/**/*.ts",
        "evals/intent-discovery/**/*.mjs"
      ],
      "ignoreBinaries": ["copilot"],
      "ignoreFiles": ["evals/intent-discovery/fixtures/**/src/**/*"]
    },
    "packages/intent": {
      "entry": [
        "src/index.ts",
        "src/cli.ts",
        "src/core.ts",
        "src/setup.ts",
        "src/catalog.ts"
      ],
      "ignoreDependencies": ["verdaccio"]
    }
  }
}
